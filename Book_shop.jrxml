<jasperReport name="Book_shop" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dd34a177-b68f-4fea-ad35-8c65d420656c">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BookShopDB"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="sales" class="java.lang.String">
		<defaultValueExpression><![CDATA["INN-00001"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
    s.sale_id,
    s.sale_date,
    c.customer_name,
    b.book_name,
    si.quantity,
    si.unit_price,
    si.subtotal
FROM sales s
JOIN customers c 
    ON s.customer_id = c.customer_id
JOIN sale_items si 
    ON s.sale_id = si.sale_id
JOIN books b 
    ON si.book_id = b.book_id]]></query>
